class_name TileAtlas
extends RefCounted
## Sprite atlases (generated by tools/gen_art.py) and how tiles map to them.
##
## - Grounds, cliffs and rock walls are drawn by the terrain shader
##   (see TerrainRenderer), not by tiles.
## - Blocks (plants, trees, props) use the block atlas: 16 columns of
##   32x48 px cells, cell index = block id, anchored at the bottom center of
##   their map cell.
## - Sun shadows use a second, blank atlas with wider 80x48 cells: the
##   shadow shader projects each block's silhouette inside them.

const BLOCK_TEXTURE := preload("res://assets/textures/tiles/block_atlas.png")
const BLOCK_NORMALS := preload("res://assets/textures/tiles/block_atlas_n.png")

const BLOCK_SOURCE := 0
const SHADOW_SOURCE := 1

const BLOCK_COLUMNS := 16
const BLOCK_CELL := Vector2i(32, 48)
const SHADOW_CELL := Vector2i(80, 48)
## Blocks are sorted with entities at their base (near the cell bottom).
const BLOCK_Y_SORT_ORIGIN := 6

## Solid terrain blocks drawn by the terrain shader (value = wall atlas row).
const WALL_KINDS := {
	Tiles.Block.STONE: 0,
	Tiles.Block.DEEPSLATE: 1,
	Tiles.Block.COAL_ORE: 2,
	Tiles.Block.COPPER_ORE: 3,
	Tiles.Block.IRON_ORE: 4,
	Tiles.Block.GOLD_ORE: 5,
	Tiles.Block.LAPIS_ORE: 6,
	Tiles.Block.RUBY_ORE: 7,
	Tiles.Block.DIAMOND_ORE: 8,
	Tiles.Block.EMERALD_ORE: 9,
	Tiles.Block.SANDSTONE: 10,
	Tiles.Block.PACKED_ICE: 11,
}
const GLOWING_WALLS := {
	Tiles.Block.GOLD_ORE: true,
	Tiles.Block.LAPIS_ORE: true,
	Tiles.Block.RUBY_ORE: true,
	Tiles.Block.DIAMOND_ORE: true,
	Tiles.Block.EMERALD_ORE: true,
}
## Blocks that bend in the wind.
const SWAYING := {
	Tiles.Block.OAK: true,
	Tiles.Block.BIRCH: true,
	Tiles.Block.SPRUCE: true,
	Tiles.Block.SNOWY_SPRUCE: true,
	Tiles.Block.DARK_OAK: true,
	Tiles.Block.JUNGLE_TREE: true,
	Tiles.Block.ACACIA: true,
	Tiles.Block.SWAMP_OAK: true,
	Tiles.Block.BUSH: true,
	Tiles.Block.BERRY_BUSH: true,
	Tiles.Block.TALL_GRASS: true,
	Tiles.Block.FERN: true,
	Tiles.Block.FLOWER_RED: true,
	Tiles.Block.FLOWER_YELLOW: true,
	Tiles.Block.FLOWER_BLUE: true,
	Tiles.Block.FLOWER_WHITE: true,
	Tiles.Block.FLOWER_PINK: true,
	Tiles.Block.SUGAR_CANE: true,
	Tiles.Block.DEAD_BUSH: true,
}
## Blocks too flat or small to cast a sun shadow.
const NO_SHADOW := {
	Tiles.Block.LILY_PAD: true,
	Tiles.Block.TALL_GRASS: true,
	Tiles.Block.FLOWER_RED: true,
	Tiles.Block.FLOWER_YELLOW: true,
	Tiles.Block.FLOWER_BLUE: true,
	Tiles.Block.FLOWER_WHITE: true,
	Tiles.Block.FLOWER_PINK: true,
	Tiles.Block.DEAD_BUSH: true,
}

## block id -> wall kind + 1 (0 = not a wall), for fast data building.
static var wall_lookup := _build_wall_lookup()


static func is_wall(block: int) -> bool:
	return WALL_KINDS.has(block)


## Atlas coords (in 16 px units) of a block's 32x48 cell.
static func block_cell(block: int) -> Vector2i:
	return Vector2i((block % BLOCK_COLUMNS) * 2, (block / BLOCK_COLUMNS) * 3)


static func shadow_cell(block: int) -> Vector2i:
	return Vector2i((block % BLOCK_COLUMNS) * 5, (block / BLOCK_COLUMNS) * 3)


static func block_rows() -> int:
	return BLOCK_TEXTURE.get_height() / BLOCK_CELL.y


static func build_tile_set() -> TileSet:
	var result := TileSet.new()
	result.tile_size = Vector2i(GameConst.TILE_SIZE, GameConst.TILE_SIZE)
	var region := Vector2i(GameConst.TILE_SIZE, GameConst.TILE_SIZE)

	var texture := CanvasTexture.new()
	texture.diffuse_texture = BLOCK_TEXTURE
	texture.normal_texture = BLOCK_NORMALS
	var blocks := TileSetAtlasSource.new()
	blocks.texture = texture
	blocks.texture_region_size = region
	var shadows := TileSetAtlasSource.new()
	var blank := Image.create(
		SHADOW_CELL.x * BLOCK_COLUMNS, SHADOW_CELL.y * block_rows(), false, Image.FORMAT_L8
	)
	shadows.texture = ImageTexture.create_from_image(blank)
	shadows.texture_region_size = region
	for block in range(1, Tiles.Block.size()):
		if is_wall(block):
			continue
		_add_tile(blocks, block_cell(block), BLOCK_CELL / region)
		_add_tile(shadows, shadow_cell(block), SHADOW_CELL / region)
	result.add_source(blocks, BLOCK_SOURCE)
	result.add_source(shadows, SHADOW_SOURCE)
	return result


static func _add_tile(source: TileSetAtlasSource, cell: Vector2i, size: Vector2i) -> void:
	source.create_tile(cell, size)
	var data := source.get_tile_data(cell, 0)
	# Anchor the bottom of the sprite on its map cell; sort at its base.
	data.texture_origin = Vector2i(0, (size.y * GameConst.TILE_SIZE - GameConst.TILE_SIZE) / 2)
	data.y_sort_origin = BLOCK_Y_SORT_ORIGIN


static func _build_wall_lookup() -> PackedByteArray:
	var lookup := PackedByteArray()
	lookup.resize(256)
	for block: int in WALL_KINDS:
		lookup[block] = WALL_KINDS[block] + 1
	return lookup
