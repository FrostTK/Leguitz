class_name TileAtlas
extends RefCounted
## Maps tiles to atlas cells and builds the TileSet (layouts generated by
## tools/gen_placeholder_art.py):
## - ground atlas: one 16 px row per ground id, 4 variants per row,
## - block atlas: 16 columns of 16x32 cells, cell index = block id,
## - cliff atlas: row 0 = cliff faces (4 materials) then ramps,
##   row 1 = edge overlays indexed by OVERLAY_* bits.

enum CliffMaterial { DIRT, STONE, SAND, SNOW }

const GROUND_TEXTURE := preload("res://assets/textures/tiles/ground_atlas.png")
const BLOCK_TEXTURE := preload("res://assets/textures/tiles/block_atlas.png")
const CLIFF_TEXTURE := preload("res://assets/textures/tiles/cliff_atlas.png")

const GROUND_SOURCE := 0
const BLOCK_SOURCE := 1
const CLIFF_SOURCE := 2

const GROUND_VARIANTS := 4
const BLOCK_COLUMNS := 16
const VARIANT_SEED := 0x5EED
## Blocks are sorted with entities at their base (near the cell bottom).
const BLOCK_Y_SORT_ORIGIN := 6

const OVERLAY_NORTH := 1
const OVERLAY_EAST := 2
const OVERLAY_WEST := 4
const OVERLAY_SHADOW := 8

const STONE_GROUNDS := {
	Tiles.Ground.STONE_FLOOR: true,
	Tiles.Ground.GRAVEL: true,
	Tiles.Ground.DEEPSLATE_FLOOR: true,
}
const SAND_GROUNDS := {
	Tiles.Ground.SAND: true,
	Tiles.Ground.RED_SAND: true,
	Tiles.Ground.TERRACOTTA: true,
	Tiles.Ground.TERRACOTTA_LIGHT: true,
}
const SNOW_GROUNDS := {Tiles.Ground.SNOW: true, Tiles.Ground.ICE: true}


static func ground_cell(ground: int, tile: Vector2i) -> Vector2i:
	var variant := HashUtil.hash2(VARIANT_SEED, tile.x, tile.y) % GROUND_VARIANTS
	return Vector2i(variant, ground)


static func block_cell(block: int) -> Vector2i:
	return Vector2i(block % BLOCK_COLUMNS, (block / BLOCK_COLUMNS) * 2)


static func cliff_material(ground: int) -> int:
	if STONE_GROUNDS.has(ground):
		return CliffMaterial.STONE
	if SAND_GROUNDS.has(ground):
		return CliffMaterial.SAND
	if SNOW_GROUNDS.has(ground):
		return CliffMaterial.SNOW
	return CliffMaterial.DIRT


static func face_cell(ground: int, ramp: bool) -> Vector2i:
	return Vector2i(cliff_material(ground) + (4 if ramp else 0), 0)


static func overlay_cell(bits: int) -> Vector2i:
	return Vector2i(bits, 1)


## Overlay bits for a tile's shape flags (0 = no overlay).
static func overlay_bits(shape: int) -> int:
	var bits := 0
	if shape & ChunkData.SHAPE_RAMP == 0:
		if shape & ChunkData.SHAPE_LOWER_N:
			bits |= OVERLAY_NORTH
		if shape & ChunkData.SHAPE_LOWER_E:
			bits |= OVERLAY_EAST
		if shape & ChunkData.SHAPE_LOWER_W:
			bits |= OVERLAY_WEST
	if shape & ChunkData.SHAPE_SHADOW:
		bits |= OVERLAY_SHADOW
	return bits


static func build_tile_set() -> TileSet:
	var result := TileSet.new()
	result.tile_size = Vector2i(GameConst.TILE_SIZE, GameConst.TILE_SIZE)
	var region := Vector2i(GameConst.TILE_SIZE, GameConst.TILE_SIZE)

	var ground_source := TileSetAtlasSource.new()
	ground_source.texture = GROUND_TEXTURE
	ground_source.texture_region_size = region
	for ground in range(1, Tiles.Ground.size()):
		for variant in GROUND_VARIANTS:
			ground_source.create_tile(Vector2i(variant, ground))
	result.add_source(ground_source, GROUND_SOURCE)

	var block_source := TileSetAtlasSource.new()
	block_source.texture = BLOCK_TEXTURE
	block_source.texture_region_size = region
	for block in range(1, Tiles.Block.size()):
		var cell := block_cell(block)
		block_source.create_tile(cell, Vector2i(1, 2))
		var data := block_source.get_tile_data(cell, 0)
		# Anchor the bottom of the 16x32 sprite on its cell; sort at its base.
		data.texture_origin = Vector2i(0, GameConst.TILE_SIZE / 2)
		data.y_sort_origin = BLOCK_Y_SORT_ORIGIN
	result.add_source(block_source, BLOCK_SOURCE)

	var cliff_source := TileSetAtlasSource.new()
	cliff_source.texture = CLIFF_TEXTURE
	cliff_source.texture_region_size = region
	for column in 8:
		cliff_source.create_tile(Vector2i(column, 0))
	for bits in range(1, 16):
		cliff_source.create_tile(overlay_cell(bits))
	result.add_source(cliff_source, CLIFF_SOURCE)
	return result
