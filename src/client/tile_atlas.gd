class_name TileAtlas
extends RefCounted
## Sprite atlases (generated by tools/gen_art.py) and how tiles map to them.
##
## - Grounds, cliffs and rock walls are part of the terrain meshes (see
##   ChunkMesher and TerrainRenderer).
## - Blocks (plants, trees, props) are upright sprites from the block atlas:
##   16 columns of 32x48 px cells, cell index = block id, standing at the
##   center of their map cell.

const BLOCK_TEXTURE := preload("res://assets/textures/tiles/block_atlas.png")
const BLOCK_NORMALS := preload("res://assets/textures/tiles/block_atlas_n.png")

const BLOCK_COLUMNS := 16
const BLOCK_CELL := Vector2i(32, 48)

## Solid terrain blocks drawn by the terrain shader (value = wall atlas row).
const WALL_KINDS := {
	Tiles.Block.STONE: 0,
	Tiles.Block.DEEPSLATE: 1,
	Tiles.Block.COAL_ORE: 2,
	Tiles.Block.COPPER_ORE: 3,
	Tiles.Block.IRON_ORE: 4,
	Tiles.Block.GOLD_ORE: 5,
	Tiles.Block.LAPIS_ORE: 6,
	Tiles.Block.RUBY_ORE: 7,
	Tiles.Block.DIAMOND_ORE: 8,
	Tiles.Block.EMERALD_ORE: 9,
	Tiles.Block.SANDSTONE: 10,
	Tiles.Block.PACKED_ICE: 11,
}
const GLOWING_WALLS := {
	Tiles.Block.GOLD_ORE: true,
	Tiles.Block.LAPIS_ORE: true,
	Tiles.Block.RUBY_ORE: true,
	Tiles.Block.DIAMOND_ORE: true,
	Tiles.Block.EMERALD_ORE: true,
}
## Blocks that bend in the wind.
const SWAYING := {
	Tiles.Block.OAK: true,
	Tiles.Block.BIRCH: true,
	Tiles.Block.SPRUCE: true,
	Tiles.Block.SNOWY_SPRUCE: true,
	Tiles.Block.DARK_OAK: true,
	Tiles.Block.JUNGLE_TREE: true,
	Tiles.Block.ACACIA: true,
	Tiles.Block.SWAMP_OAK: true,
	Tiles.Block.BUSH: true,
	Tiles.Block.BERRY_BUSH: true,
	Tiles.Block.TALL_GRASS: true,
	Tiles.Block.FERN: true,
	Tiles.Block.FLOWER_RED: true,
	Tiles.Block.FLOWER_YELLOW: true,
	Tiles.Block.FLOWER_BLUE: true,
	Tiles.Block.FLOWER_WHITE: true,
	Tiles.Block.FLOWER_PINK: true,
	Tiles.Block.SUGAR_CANE: true,
	Tiles.Block.DEAD_BUSH: true,
}
## Blocks too flat or small to cast a sun shadow.
const NO_SHADOW := {
	Tiles.Block.LILY_PAD: true,
	Tiles.Block.TALL_GRASS: true,
	Tiles.Block.FLOWER_RED: true,
	Tiles.Block.FLOWER_YELLOW: true,
	Tiles.Block.FLOWER_BLUE: true,
	Tiles.Block.FLOWER_WHITE: true,
	Tiles.Block.FLOWER_PINK: true,
	Tiles.Block.DEAD_BUSH: true,
}

## block id -> wall kind + 1 (0 = not a wall), for fast data building.
static var wall_lookup := _build_wall_lookup()


static func is_wall(block: int) -> bool:
	return WALL_KINDS.has(block)


## Atlas cell (column, row) of a block's sprite.
static func block_cell(block: int) -> Vector2i:
	return Vector2i(block % BLOCK_COLUMNS, block / BLOCK_COLUMNS)


static func block_rows() -> int:
	return BLOCK_TEXTURE.get_height() / BLOCK_CELL.y


static func _build_wall_lookup() -> PackedByteArray:
	var lookup := PackedByteArray()
	lookup.resize(256)
	for block: int in WALL_KINDS:
		lookup[block] = WALL_KINDS[block] + 1
	return lookup
