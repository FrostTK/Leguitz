## Movement speed multiplier per ground type (swimming, snow, mud...).
const GROUND_SPEED := {
	Ground.DEEP_WATER: 0.45,
	Ground.WATER: 0.6,
	Ground.LAVA: 0.4,
	Ground.SWAMP_WATER: 0.6,
	Ground.WARM_WATER: 0.6,
	Ground.SAND: 0.92,
	Ground.RED_SAND: 0.92,
	Ground.SNOW: 0.85,
	Ground.MUD: 0.75,
	Ground.GRAVEL: 0.95,
}

const WATER_GROUNDS := {
	Ground.DEEP_WATER: true,
	Ground.WATER: true,
	Ground.SWAMP_WATER: true,
	Ground.WARM_WATER: true,
	Ground.WATER_FLOW_1: true,
	Ground.WATER_FLOW_2: true,
	Ground.WATER_FLOW_3: true,
	Ground.WATER_FLOW_4: true,
	Ground.WATER_FALLING: true,
}
const LAVA_GROUNDS := {
	Ground.LAVA: true,
	Ground.LAVA_FLOW_1: true,
	Ground.LAVA_FLOW_2: true,
	Ground.LAVA_FALLING: true,
}
## The liquid a flowing one comes from (its look, its speed...).
const FLOWING_FROM := {
	Ground.WATER_FLOW_1: Ground.WATER,
	Ground.WATER_FLOW_2: Ground.WATER,
	Ground.WATER_FLOW_3: Ground.WATER,
	Ground.WATER_FLOW_4: Ground.WATER,
	Ground.WATER_FALLING: Ground.WATER,
	Ground.LAVA_FLOW_1: Ground.LAVA,
	Ground.LAVA_FLOW_2: Ground.LAVA,
	Ground.LAVA_FALLING: Ground.LAVA,
}
## Grounds you cannot walk on (for now: lava).
const SOLID_GROUNDS := {
	Ground.LAVA: true,
	Ground.LAVA_FLOW_1: true,
	Ground.LAVA_FLOW_2: true,
	Ground.LAVA_FALLING: true,
	Ground.NONE: true,
}


## Stairs and slabs (ShapedBlocks): the blocks from OAK_STAIRS to
## CUT_SANDSTONE_SIDE_SLAB_EAST, from COBBLESTONE_STAIRS to
## PLASTER_QUARTER_TOP_EAST, and the roofs' pieces (no table: Voxels' flags
## are built from it before anything else).
static func is_shaped(block: int) -> bool:
	return (
		block >= Block.OAK_STAIRS and block <= Block.CUT_SANDSTONE_SIDE_SLAB_EAST
		or block >= Block.COBBLESTONE_STAIRS and block <= Block.PLASTER_QUARTER_TOP_EAST
		or is_roof(block)
	)


## The roofs' pieces (RoofBlocks): TILE_ROOF to THATCH_ROOF_GENTLE_HIGH_EAST.
static func is_roof(block: int) -> bool:
	return block >= Block.TILE_ROOF and block <= Block.THATCH_ROOF_GENTLE_HIGH_EAST


static func is_block_solid(block: int) -> bool:
	return not TileSets.NON_SOLID_BLOCKS.has(block)


static func is_cube(block: int) -> bool:
	return TileSets.CUBE_BLOCKS.has(block)


static func is_ground_solid(ground: int) -> bool:
	return SOLID_GROUNDS.has(ground)


static func ground_speed(ground: int) -> float:
	return GROUND_SPEED.get(liquid_source(ground), 1.0)


static func is_water(ground: int) -> bool:
	return WATER_GROUNDS.has(ground)


static func is_lava(ground: int) -> bool:
	return LAVA_GROUNDS.has(ground)


## The still liquid a flowing one comes from (any other ground: itself).
static func liquid_source(ground: int) -> int:
	return FLOWING_FROM.get(ground, ground)


static func is_ore(block: int) -> bool:
	return block >= Block.COAL_ORE and block <= Block.EMERALD_ORE
